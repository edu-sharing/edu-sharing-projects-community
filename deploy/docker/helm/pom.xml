<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.edu_sharing</groupId>
    <artifactId>edu_sharing-projects-community-deploy-docker</artifactId>
    <version>git</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>edu_sharing-projects-community-deploy-docker-helm</artifactId>
  <packaging>jar</packaging>

  <name>edu_sharing-projects-community-deploy-docker-helm</name>

  <properties>

    <helm.edusharing_services_rendering.enabled>
      false
    </helm.edusharing_services_rendering.enabled>
    <helm.edusharing_services_rendering.line1/>
    <helm.edusharing_services_rendering.line2/>
    <helm.edusharing_services_rendering.line3/>
    <helm.edusharing_services_rendering.line4/>

    <helm.edusharing_services_rendering2.enabled>
      false
    </helm.edusharing_services_rendering2.enabled>
    <helm.edusharing_services_rendering2.line1/>
    <helm.edusharing_services_rendering2.line2/>
    <helm.edusharing_services_rendering2.line3/>
    <helm.edusharing_services_rendering2.line4/>

  </properties>

  <build>

    <resources>

      <resource>
        <directory>src/main/chart</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>Chart.yaml</exclude>
          <exclude>values.yaml</exclude>
        </excludes>
      </resource>

      <resource>
        <directory>src/main/chart</directory>
        <filtering>true</filtering>
        <includes>
          <include>Chart.yaml</include>
          <include>values.yaml</include>
        </includes>
      </resource>

    </resources>

    <plugins>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>edusharing_repository</id>
            <goals>
              <goal>unpack-dependencies</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <includeArtifactIds>
                edu_sharing-projects-community-repository-deploy-docker-helm
              </includeArtifactIds>
              <type>tar.gz</type>
              <classifier>bin</classifier>
              <outputDirectory>${project.build.directory}/chart/charts/${helm.prefix}-repository</outputDirectory>
            </configuration>
          </execution>          <execution>
            <id>edusharing_services_rendering</id>
            <goals>
              <goal>unpack-dependencies</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <includeArtifactIds>
                edu_sharing-community-services-rendering-deploy-docker-helm-bundle
              </includeArtifactIds>
              <type>tar.gz</type>
              <classifier>bin</classifier>
              <outputDirectory>${project.build.directory}/chart/charts/edu_sharing-community-services-rendering
              </outputDirectory>
            </configuration>
          </execution>
          <execution>
            <id>edusharing_services_rendering2</id>
            <goals>
              <goal>unpack-dependencies</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <includeArtifactIds>
                edu_sharing-community-services-rendering2-deploy-docker-helm-bundle
              </includeArtifactIds>
              <type>tar.gz</type>
              <classifier>bin</classifier>
              <outputDirectory>${project.build.directory}/chart/charts/edu_sharing-community-services-rendering2
              </outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>io.kokuwa.maven</groupId>
        <artifactId>helm-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>init</id>
            <goals>
              <goal>init</goal>
            </goals>
            <phase>initialize</phase>
          </execution>
          <execution>
            <id>dependency-build</id>
            <goals>
              <goal>dependency-build</goal>
            </goals>
            <phase>compile</phase>
          </execution>
          <execution>
            <id>lint</id>
            <goals>
              <goal>lint</goal>
            </goals>
            <phase>test</phase>
          </execution>
          <execution>
            <id>package</id>
            <goals>
              <goal>package</goal>
            </goals>
            <phase>package</phase>
          </execution>
          <execution>
            <id>upload</id>
            <goals>
              <goal>upload</goal>
            </goals>
            <phase>deploy</phase>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>jar</goal>
            </goals>
            <phase>package</phase>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <executions>
          <execution>
            <id>assembly</id>
            <goals>
              <goal>single</goal>
            </goals>
            <phase>package</phase>
          </execution>
        </executions>
      </plugin>

    </plugins>

    <pluginManagement>

      <plugins>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <configuration>
            <outputDirectory>${project.build.directory}/chart</outputDirectory>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-assembly-plugin</artifactId>
          <configuration>
            <descriptors>
              <descriptor>src/main/assembly/bin.xml</descriptor>
            </descriptors>
          </configuration>
        </plugin>

      </plugins>

    </pluginManagement>

  </build>

  <dependencies>

    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>edu_sharing-projects-community-repository-deploy-docker-helm</artifactId>
      <type>tar.gz</type>
      <classifier>bin</classifier>
    </dependency>

  </dependencies>

  <profiles>

    <profile>

      <id>service.rendering</id>

      <activation>
        <activeByDefault>false</activeByDefault>
        <property>
          <name>env.SERVICE_RENDERING_ENABLED</name>
          <value>true</value>
        </property>
      </activation>

      <properties>

        <helm.edusharing_services_rendering.enabled>
          true
        </helm.edusharing_services_rendering.enabled>
        <helm.edusharing_services_rendering.line1>
          - name: edu_sharing-community-services-rendering
        </helm.edusharing_services_rendering.line1>
        <helm.edusharing_services_rendering.line2>
          <!--suppress UnresolvedMavenProperty -->
          version:
          ${org.edu_sharing:edu_sharing-community-services-rendering-deploy-docker-helm-bundle:tar.gz:bin.range}
        </helm.edusharing_services_rendering.line2>
        <helm.edusharing_services_rendering.line3>
          alias: edusharing_services_rendering
        </helm.edusharing_services_rendering.line3>
        <helm.edusharing_services_rendering.line4>
          condition: edusharing_services_rendering.enabled
        </helm.edusharing_services_rendering.line4>

      </properties>

      <build>

        <plugins>

          <plugin>
            <groupId>org.codehaus.gmavenplus</groupId>
            <artifactId>gmavenplus-plugin</artifactId>
            <executions>
              <execution>
                <id>services_rendering</id>
                <goals>
                  <goal>execute</goal>
                </goals>
                <phase>generate-sources</phase>
                <configuration>
                  <scripts>
                    <!--suppress UnresolvedMavenProperty -->
                    <script><![CDATA[
                      def version = project.properties['org.edu_sharing:edu_sharing-community-services-rendering-deploy-docker-helm-bundle:tar.gz:bin.version']
                      ${git.semver}
                      project.properties.setProperty('org.edu_sharing:edu_sharing-community-services-rendering-deploy-docker-helm-bundle:tar.gz:bin.range', semver)
                    ]]></script>
                  </scripts>
                </configuration>
              </execution>
            </executions>
          </plugin>

        </plugins>

      </build>

      <dependencies>

        <dependency>
          <groupId>${project.groupId}</groupId>
          <artifactId>edu_sharing-community-services-rendering-deploy-docker-helm-bundle</artifactId>
          <type>tar.gz</type>
          <classifier>bin</classifier>
        </dependency>

      </dependencies>

    </profile>

    <profile>

      <id>service.rendering2</id>

      <activation>
        <activeByDefault>false</activeByDefault>
        <property>
          <name>env.SERVICE_RENDERING2_ENABLED</name>
          <value>true</value>
        </property>
      </activation>

      <properties>

        <helm.edusharing_services_rendering2.enabled>
          true
        </helm.edusharing_services_rendering2.enabled>
        <helm.edusharing_services_rendering2.line1>
          - name: edu_sharing-community-services-rendering2
        </helm.edusharing_services_rendering2.line1>
        <helm.edusharing_services_rendering2.line2>
          <!--suppress UnresolvedMavenProperty -->
          version:
          ${org.edu_sharing:edu_sharing-community-services-rendering2-deploy-docker-helm-bundle:tar.gz:bin.range}
        </helm.edusharing_services_rendering2.line2>
        <helm.edusharing_services_rendering2.line3>
          alias: edusharing_services_rendering2
        </helm.edusharing_services_rendering2.line3>
        <helm.edusharing_services_rendering2.line4>
          condition: edusharing_services_rendering2.enabled
        </helm.edusharing_services_rendering2.line4>

      </properties>

      <build>

        <plugins>

          <plugin>
            <groupId>org.codehaus.gmavenplus</groupId>
            <artifactId>gmavenplus-plugin</artifactId>
            <executions>
              <execution>
                <id>services_rendering2</id>
                <goals>
                  <goal>execute</goal>
                </goals>
                <phase>generate-sources</phase>
                <configuration>
                  <scripts>
                    <!--suppress UnresolvedMavenProperty -->
                    <script><![CDATA[
                      def version = project.properties['org.edu_sharing:edu_sharing-community-services-rendering2-deploy-docker-helm-bundle:tar.gz:bin.version']
                      ${git.semver}
                      project.properties.setProperty('org.edu_sharing:edu_sharing-community-services-rendering2-deploy-docker-helm-bundle:tar.gz:bin.range', semver)
                    ]]></script>
                  </scripts>
                </configuration>
              </execution>
            </executions>
          </plugin>

        </plugins>

      </build>
      
      <dependencies>

        <dependency>
          <groupId>${project.groupId}</groupId>
          <artifactId>edu_sharing-community-services-rendering2-deploy-docker-helm-bundle</artifactId>
          <type>tar.gz</type>
          <classifier>bin</classifier>
        </dependency>

      </dependencies>

    </profile>

  </profiles>

</project>
